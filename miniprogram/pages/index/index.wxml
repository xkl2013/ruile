<view class="page">
  <view class="card hero">
    <view class="title">睿乐大脑 Knowledge</view>
    <view class="muted">Import a web page into a selected knowledge base from WeChat.</view>
  </view>

  <view class="card section">
    <view wx:if="{{needsSettings}}" class="notice">
      Configure the 睿乐大脑 API base URL and API key before loading knowledge bases.
      <button bindtap="openSettings" class="secondary">Open Settings</button>
    </view>

    <view class="field">
      <text class="label">Knowledge Base</text>
      <picker range="{{knowledgeBaseNames}}" value="{{selectedIndex}}" bindchange="onKnowledgeBaseChange">
        <view class="picker-value">{{selectedKnowledgeBaseName || "Tap to select"}}</view>
      </picker>
      <view wx:if="{{statusMessage}}" class="status-message">{{statusMessage}}</view>
      <view wx:if="{{knowledgeBaseNames.length}}" class="knowledge-list">
        <view
          wx:for="{{knowledgeBaseNames}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onKnowledgeBaseTap"
          class="knowledge-item {{index == selectedIndex ? 'active' : ''}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <button bindtap="loadKnowledgeBases" loading="{{loading}}">Refresh knowledge bases</button>
  </view>

  <view wx:if="{{storageUsage}}" class="card section storage-card {{storageUsage.statusClass}}">
    <view class="storage-head">
      <view>
        <view class="label">Storage Usage</view>
        <view class="storage-percent">{{storageUsage.percentText}}</view>
      </view>
      <view class="storage-quota">{{storageUsage.usedText}} / {{storageUsage.quotaText}}</view>
    </view>
    <progress
      wx:if="{{storageUsage.status != 'unlimited'}}"
      percent="{{storageUsage.progressPercent}}"
      stroke-width="8"
      activeColor="#07c05f"
      backgroundColor="#e5e7eb"
    />
    <view class="storage-meta">Remaining {{storageUsage.remainingText}}</view>
    <view wx:if="{{storageUsage.notice}}" class="storage-notice">{{storageUsage.notice}}</view>
  </view>

  <view class="card section">
    <view class="field">
      <text class="label">URL</text>
      <input value="{{url}}" placeholder="https://example.com/article" bindinput="onUrlInput" />
    </view>

    <button
      bindtap="importURL"
      loading="{{importing}}"
      disabled="{{!selectedKnowledgeBaseId || !url || storageBlocked}}"
    >
      Import URL
    </button>
  </view>
</view>
